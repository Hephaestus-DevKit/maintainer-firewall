{
  "name": "maintainer-firewall",
  "version": "0.7.2",
  "description": "A maintainer-first GitHub Action that filters noisy issues and pull requests by evidence, reproducibility, scope, and project-specific rules.",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "action.yml",
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "SUPPORT.md",
    "docs",
    "examples",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "node scripts/bundle.mjs",
    "ci": "npm run check && npm run evaluate && node scripts/market-check.mjs && npm run verify:dist",
    "demo": "npm run build && node scripts/demo.mjs",
    "evaluate": "npm run build && node scripts/evaluate.mjs",
    "evaluate:ai": "npm run build && node scripts/evaluate-ai.mjs",
    "metrics:summary": "node scripts/summarize-metrics.mjs",
    "coverage": "vitest run --coverage",
    "market:check": "npm run release:check && npm pack --dry-run",
    "release:check": "npm run ci && npm run coverage && npm run demo && npm audit --audit-level=moderate",
    "verify:dist": "node scripts/bundle.mjs --verify",
    "test": "vitest run",
    "check": "npm run build && npm run test"
  },
  "keywords": [
    "github-action",
    "open-source",
    "maintainers",
    "issue-triage",
    "pull-request-review"
  ],
  "author": "Hephaestus-DevKit",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hephaestus-DevKit/maintainer-firewall.git"
  },
  "bugs": {
    "url": "https://github.com/Hephaestus-DevKit/maintainer-firewall/issues"
  },
  "homepage": "https://github.com/Hephaestus-DevKit/maintainer-firewall#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "minimatch": "^11.0.9",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vercel/ncc": "^0.38.3",
    "@vitest/coverage-v8": "^4.1.12",
    "fast-check": "^4.8.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
